digraph activate_iri {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.6, ranksep=0.9, bgcolor="white", splines=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#F6F7F9", color="#5B6470", margin="0.25,0.14"];
  edge  [fontname="Helvetica", fontsize=10, color="#5B6470"];

  amsc [label="AmSC orchestrator\n(AmSC-IRO, AmSCROT, Airflow)", fillcolor="#EEF1F5"];
  user [label="ACTIVATE user\n(iri-job workflow, iri command)", fillcolor="#EEF1F5"];

  ep [label="activate-iri endpoint\nhttps://iri.activate.pw/api/v2\n\nOne IRI Facility API (v2) for everything ACTIVATE reaches,\nwith other facilities consolidated behind it",
      fillcolor="#E8F0FE", color="#1967D2", penwidth=1.8];

  systems [label="Systems ACTIVATE reaches (no IRI software on them)\nlab clusters  |  existing and NeoCloud clusters  |  elastic cloud Slurm  |  partner sites via the edge kit",
           color="#1967D2"];
  labs [label="Facilities with their own IRI endpoints\nALCF  |  NERSC  |  OLCF  |  ESnet", color="#1E7F5C"];

  { rank=same; amsc; user; }
  { rank=same; systems; labs; }

  amsc -> ep   [label="  mode 1: AmSC calls in\n  (Keycard or ACTIVATE credential)", color="#1967D2", penwidth=1.6];
  user -> ep   [label="  mode 2: users call any facility\n  through one URL", color="#1E7F5C", penwidth=1.6];
  user -> labs [label="  or directly", style=dashed, color="#1E7F5C"];
  ep -> systems [label="  jobs and file operations run\n  through the ACTIVATE API\n  (workflow runs, SSH, or local)", color="#1967D2", penwidth=1.6];
  ep -> labs   [label="  gateway: forwarded with\n  the caller's facility token", color="#1E7F5C", penwidth=1.6];
}
